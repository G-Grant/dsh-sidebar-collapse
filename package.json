{
  "name": "dsh-sidebar-collapse",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：独立折叠侧边栏功能入口栏，为工作区腾出空间。",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "sidebar"
  ],
  "license": "MIT",
  "author": "G-Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G-Grant/dsh-sidebar-collapse.git"
  },
  "homepage": "https://github.com/G-Grant/dsh-sidebar-collapse#readme",
  "bugs": {
    "url": "https://github.com/G-Grant/dsh-sidebar-collapse/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build && node --check dist/index.js && node --check dist/client.js",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.8.0"
}
